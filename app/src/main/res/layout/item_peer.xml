<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_glass_card"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imagePeerAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_glass_circle"
        android:src="@drawable/ic_baseline_person_24"
        android:padding="16dp"
        app:tint="?android:textColorSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/textDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Device Name"
        android:textColor="?android:textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01"
        app:layout_constraintStart_toEndOf="@id/imagePeerAvatar"
        app:layout_constraintEnd_toStartOf="@id/buttonConnect"
        app:layout_constraintTop_toTopOf="@id/imagePeerAvatar"
        app:layout_constraintBottom_toTopOf="@id/textDeviceStatus"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textDeviceStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Nearby"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/imagePeerAvatar"
        app:layout_constraintEnd_toStartOf="@id/buttonConnect"
        app:layout_constraintTop_toBottomOf="@id/textDeviceName"
        app:layout_constraintBottom_toBottomOf="@id/imagePeerAvatar" />

    <Button
        android:id="@+id/buttonConnect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/bg_premium_button"
        android:paddingHorizontal="24dp"
        android:text="Connect"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
