<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeshCall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/meshcall_primary</item>
        <item name="colorPrimaryVariant">@color/meshcall_primary_variant</item>
        <item name="colorOnPrimary">@color/meshcall_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/meshcall_secondary</item>
        <item name="colorSecondaryVariant">@color/meshcall_secondary_variant</item>
        <item name="colorOnSecondary">@color/meshcall_on_secondary</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/meshcall_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/meshcall_bg_dark</item>
        <item name="colorSurface">@color/meshcall_surface_dark</item>
        <item name="colorOnSurface">@color/meshcall_text_primary_dark</item>
        <item name="android:textColorPrimary">@color/meshcall_text_primary_dark</item>
        <item name="android:textColorSecondary">@color/meshcall_text_secondary_dark</item>
        
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>