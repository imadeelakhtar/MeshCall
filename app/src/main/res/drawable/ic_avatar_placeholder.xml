  <path android:pathData="M70,30m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  <path android:pathData="M100,50m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  <path android:pathData="M90,90m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  <path android:pathData="M50,90m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  <path android:pathData="M40,50m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  <path android:pathData="M70,110m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" android:fillColor="#FFFFFF"/>
  
